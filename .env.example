APP_NAME=cliptrace-backend
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://cliptrace:cliptrace@db:5432/cliptrace

UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE_BYTES=524288000
MAX_VIDEO_DURATION_SECONDS=14400
MIN_VIDEO_DURATION_SECONDS=1
UPLOAD_CHUNK_SIZE_BYTES=1048576
TEMP_FILE_MAX_AGE_SECONDS=86400

FFPROBE_BINARY=ffprobe
FFPROBE_TIMEOUT_SECONDS=30

MOCK_RESULT_START_SECONDS=5.0
MOCK_RESULT_DURATION_SECONDS=5.0
MIN_FRAGMENT_DURATION_SECONDS=5.0
SEARCH_RESULT_PADDING_SECONDS=1.0
SEARCH_ENGINE=semantic

ML_PIPELINE_VERSION=speech-e5-v1
ML_WORKER_POLL_SECONDS=2.0
ML_WORKER_LEASE_SECONDS=900
ML_WORKER_MAX_ATTEMPTS=3
ML_MODEL_CACHE_DIR=/app/data/models

WHISPER_MODEL=small
WHISPER_MODEL_REVISION=536b0662742c02347bc0e980a01041f333bce120
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Оставьте пустым для auto-detect; можно задать ru, en и т. п.
WHISPER_LANGUAGE=

EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

CORS_ORIGINS=["http://localhost:3000"]
