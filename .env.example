APP_NAME=cliptrace-backend
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://cliptrace:cliptrace@db:5432/cliptrace

UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE_BYTES=524288000
MAX_VIDEO_DURATION_SECONDS=14400
UPLOAD_CHUNK_SIZE_BYTES=1048576
TEMP_FILE_MAX_AGE_SECONDS=86400

FFPROBE_BINARY=ffprobe
FFPROBE_TIMEOUT_SECONDS=30

MOCK_RESULT_START_SECONDS=5.0
MOCK_RESULT_DURATION_SECONDS=5.0
MIN_FRAGMENT_DURATION_SECONDS=5.0
SEARCH_ENGINE=mock

CORS_ORIGINS=["http://localhost:3000"]
